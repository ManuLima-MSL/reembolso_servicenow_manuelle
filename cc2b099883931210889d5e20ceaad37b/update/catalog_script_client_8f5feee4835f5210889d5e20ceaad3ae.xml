        <script><![CDATA[function onChange(control, oldValue, newValue) {
    if (newValue === "") {
        return;
    }
 
    
    var arr_data = newValue.split("/"); 
 
    
    var day = parseInt(arr_data[0], 10);
    var month = parseInt(arr_data[1], 10) - 1;
    var year = parseInt(arr_data[2], 10);
 
    
    var selectedDate = new Date(year, month, day);
 
    var today = new Date();
 
    if (selectedDate > today) {
        g_form.addErrorMessage("The selected date cannot be in the future. Please select a valid date.");
        g_form.setValue("date", "");
    } else {
        g_form.clearMessages();
    }
 
 
}
]]></script>
