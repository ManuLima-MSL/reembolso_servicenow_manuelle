        <script><![CDATA[var GroupAccessValidator = Class.create();
GroupAccessValidator.prototype = {
    initialize: function() {},

    getAccessibleRecords: function(current) {
        var accessibleRecords = []; 

        var assignmentGroup = current.assignment_group;

        var userGroups = gs.getUser().getMyGroups();

        if (assignmentGroup && userGroups.indexOf(assignmentGroup.sys_id) !== -1) {
            accessibleRecords.push(current.sys_id.toString()); 
        }

        return accessibleRecords;
    },

    type: 'GroupAccessValidator'
};]]></script>
