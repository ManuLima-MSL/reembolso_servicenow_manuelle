        <script><![CDATA[var CategoryAccessUtils = Class.create();
CategoryAccessUtils.prototype = {
    initialize: function() {
    },
	userHasAccessToCategory: function(userId, categoryId) {
        
        var grCategory = new GlideRecord('x_1593183_reembo_0_categories'); 
        if (grCategory.get(categoryId)) {
            var groupId = grCategory.grupo_responsavel; 
            
            
            var grGroup = new GlideRecord('sys_user_grmember');
            grGroup.addQuery('group', groupId);
            grGroup.addQuery('user', userId);
            grGroup.query();
            
            return grGroup.hasNext(); 
        }
        return false; 
    },
    type: 'CategoryAccessUtils'
};]]></script>
